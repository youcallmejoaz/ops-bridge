# ---------------------------------------------------------------------------
# OpsBridge MCP — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# MCP client authentication.
# Clients must send `Authorization: Bearer <MCP_AUTH_SECRET>`.
# Generate a long random value, e.g.: openssl rand -hex 32
MCP_AUTH_SECRET=

# Optional: comma-separated list of scopes granted to callers presenting
# MCP_AUTH_SECRET. Defaults to full access if unset.
# Available scopes: READ_CUSTOMERS, WRITE_CUSTOMERS, WRITE_MARKETING, WRITE_CRM
MCP_AUTH_SCOPES=READ_CUSTOMERS,WRITE_CUSTOMERS,WRITE_MARKETING,WRITE_CRM

# ---------------------------------------------------------------------------
# Integration toggles — disabled integrations are not registered as tools.
# ---------------------------------------------------------------------------
ENABLE_GHL=true
ENABLE_BREVO=true
ENABLE_STRIPE=true

# ---------------------------------------------------------------------------
# GoHighLevel (GHL)
# Settings → Integrations → Private Integrations in your sub-account.
# ---------------------------------------------------------------------------
GHL_API_KEY=
GHL_LOCATION_ID=

# ---------------------------------------------------------------------------
# Brevo
# https://app.brevo.com/settings/keys/api
# ---------------------------------------------------------------------------
BREVO_API_KEY=

# ---------------------------------------------------------------------------
# Stripe
# Use a restricted or test-mode secret key where possible.
# https://dashboard.stripe.com/apikeys
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
